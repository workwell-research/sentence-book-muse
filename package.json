{
  "name": "sentence-book-muse",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5307 --strictPort",
    "build": "tsc -p tsconfig.app.json && tsc -p functions/tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5308 --strictPort",
    "pages:dev": "wrangler pages dev dist --port 8797",
    "pages:build": "wrangler pages functions build --outdir .wrangler/build",
    "types": "wrangler types --path functions/types.d.ts",
    "test": "vitest run",
    "qa": "node scripts/qa-scaffold.mjs",
    "qa:handwriting": "node scripts/qa-a5.mjs",
    "qa:print": "node scripts/qa-a5.mjs",
    "font:build": "node scripts/build-stroke-font.mjs",
    "qa:a5": "node scripts/qa-a5.mjs",
    "qa:desk": "node scripts/qa-desk.mjs",
    "font:editor": "node scripts/build-editor-font.mjs"
  },
  "dependencies": {
    "@fontsource/lora": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.118.0",
    "jose": "6.2.14",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-path-properties": "2.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "supabase": "2.122.0",
    "svgpath": "2.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
