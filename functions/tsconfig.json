{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "./types.d.ts",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "../shared"
  ]
}
