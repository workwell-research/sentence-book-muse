# Copy to .dev.vars for local Pages development (npm run pages:dev). Never commit a real key.
# Required: the Meta Model API key, or a key for another OpenAI-compatible host of the same model.
META_MODEL_API_KEY=
# Optional overrides. Defaults live in wrangler.jsonc vars (Meta Model API, muse-spark-1.3).
# Example for OpenRouter: MODEL_API_BASE_URL=https://openrouter.ai/api/v1 and MODEL_ID=meta/muse-spark-1.3
# MODEL_API_BASE_URL=
# MODEL_ID=

# Salt for hashing client addresses in the usage counters (any random string; set a different one in production).
RATE_SALT=change-me-locally
